APP_NAME="KangGui RCM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kanggui_rcm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Security defaults. Set SESSION_SECURE_COOKIE=true behind HTTPS.
ALLOW_REGISTRATION=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Optional initial administrator. Never commit real values.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Privacy-first first-party analytics
ANALYTICS_ENABLED=true
ANALYTICS_REQUIRE_CONSENT=true
ANALYTICS_DEDUP_MINUTES=30
ANALYTICS_RETENTION_DAYS=180

# Enable only when these headers are overwritten by a trusted reverse proxy/CDN.
ANALYTICS_TRUST_GEO_HEADERS=false
ANALYTICS_GEO_COUNTRY_HEADER=CF-IPCountry
ANALYTICS_GEO_REGION_HEADER=X-Geo-Region
ANALYTICS_GEO_CITY_HEADER=X-Geo-City
ANALYTICS_GEO_ORGANIZATION_HEADER=X-Geo-Organization

# Queued lead notifications
LEAD_EMAIL_NOTIFICATIONS=true
LEAD_NOTIFICATION_EMAILS=
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_RECIPIENTS=
WHATSAPP_LEAD_TEMPLATE=new_website_lead
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_CONNECT_TIMEOUT=5
WHATSAPP_TIMEOUT=10

# Optional integrations (secrets remain environment-managed)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
META_PIXEL_ID=
CRM_WEBHOOK_ENABLED=false
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
